[Unit]
Description=NATS server with JetStream
Wants=network-online.target
After=network-online.target

[Service]
User=cep
# Clients and the monitoring port listen on loopback only.
# JetStream's settings, including its disk sync interval, are in nats.conf (nats-sync.sh).
ExecStart=/opt/cep/bin/nats-server -c /etc/cep/nats.conf -a 127.0.0.1 -m 8222
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
