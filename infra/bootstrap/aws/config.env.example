# Settings for the AWS bootstrap scripts.
#
#   cp config.env.example config.env   # then fill in the blanks
#
# config.env is git-ignored: it holds your email and user names. Never commit
# it. Values are plain shell assignments (no spaces around `=`).

# --- Management account (already exists, with the AWS Organization) ---------

# AWS CLI profile that signs in to the management account through IAM Identity
# Center with admin rights. The same one cferrante-dev's bootstrap uses.
MGMT_PROFILE=management-admin
# The [sso-session ...] name from ~/.aws/config used by MGMT_PROFILE. The new
# project profile reuses it, so one `aws sso login` covers both accounts.
SSO_SESSION=my-sso

# --- Project account (01-account.sh) ----------------------------------------

PROJECT_ACCOUNT_NAME=call-event-pipeline
# Root email for the new account. Must not belong to any other AWS account,
# including cferrante-dev's. A "plus" address on an inbox you read works,
# e.g. you+call-event-pipeline@example.com.
PROJECT_ACCOUNT_EMAIL=

# --- Access (02-sso-access.sh) ----------------------------------------------

# Your user name in the IAM Identity Center portal.
SSO_USERNAME=
# Existing permission set to grant in the project account.
PERMISSION_SET_NAME=AdministratorAccess
# CLI profile the script writes to ~/.aws/config for the project account.
PROJECT_PROFILE=call-event-pipeline-admin
# The demo environment runs here (docs/design.md, section 13).
REGION=us-east-1

# --- Budget (03-budget.sh) --------------------------------------------------

BUDGET_NAME=monthly-10-usd
# Monthly limit in US dollars. Alerts fire at 50% and 100% actual, and 100%
# forecast (M3 plan, decision D4).
BUDGET_LIMIT_USD=10
# Where budget alerts are emailed.
BUDGET_EMAIL=

# --- Secrets (04-groq-key.sh) -----------------------------------------------

# SSM Parameter Store name for the Groq API key (SecureString). The key itself
# is typed at a hidden prompt and is never stored in this file.
GROQ_KEY_PARAM=/call-event-pipeline/groq-api-key
