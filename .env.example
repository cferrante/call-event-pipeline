# Run scripts/env-setup.sh to create .env (git-ignored) from this file: each "change-me"
# becomes a random secret. Re-run it after this file gains variables; it only adds missing ones.
# Load into your shell with: set -a; source .env; set +a

# Postgres connection for the app role (leads_app). Integration tests also use it to
# create and drop throwaway databases.
DATABASE_URL=postgres://leads_app:change-me@127.0.0.1:5432/leads

# NATS server (start it with: nats-server -js -sd ./data/nats -m 8222)
NATS_URL=nats://127.0.0.1:4222

# Ingest service. 8080 is often taken, so the example uses 8081.
INGEST_PORT=8081
# The URL Twilio calls; signatures are checked against it. Locally, the service itself.
INGEST_PUBLIC_URL=http://localhost:8081
# Any random string while simulating Twilio; the real one comes from the Twilio console.
TWILIO_AUTH_TOKEN=change-me
# SendGrid Inbound Parse (email leads). While SendGrid is simulated, env-setup.sh generates a
# P-256 key pair: sendhook signs with the private key, ingest verifies with the public one.
# With a real SendGrid account, set SENDGRID_PUBLIC_KEY to the security policy's public key
# and delete SENDGRID_SIMULATOR_PRIVATE_KEY. Without SENDGRID_PUBLIC_KEY the email route is off.
SENDGRID_SIMULATOR_PRIVATE_KEY=generate-p256-private-key
SENDGRID_PUBLIC_KEY=derive-from-simulator-private-key
# Optional: forward calls to this number (E.164). Without it, calls are answered and ended.
# INGEST_FORWARD_TO=+14158675310

# Inference service (all optional; defaults shown). Workers default to the model's capacity.
# MODEL_CAPACITY=4
# INFERENCE_WORKERS=4
# MODEL_LATENCY=200ms
# MODEL_TIMEOUT=2s
